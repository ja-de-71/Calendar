rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // PUBLIC DAY SUMMARY - Safe anonymized data for public calendar
    // Contains only: date, time, rinks, and notes (no names/phones/emails)
    match /publicDaySummary/{dayId} {
      allow read: if true;  // Public can read
      allow write: if request.auth != null;  // Only authenticated staff can write
    }

    // BOOKINGS - Private customer data (TEMPORARILY still readable - will lock down after migration)
    match /bookings/{bookingId} {
      allow read: if true;  // TODO: Lock down after public calendar migration
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // BLACKOUTS - Can be read by anyone
    match /blackouts/{blackoutId} {
      allow read: if true;
      allow create, delete: if request.auth != null;
    }
  }
}
