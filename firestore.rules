rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Bookings can be read by anyone, but only created, updated or deleted by authenticated users.
    match /bookings/{bookingId} {
      allow read: if true;
      allow create: if request.auth != null;
      // Allow update/delete if authenticated AND (booking has no uid OR user owns the booking)
      allow update, delete: if request.auth != null && (!('uid' in resource.data) || request.auth.uid == resource.data.uid);
    }

    // Blackouts can be read by anyone, but only created or deleted by an authenticated user.
    match /blackouts/{blackoutId} {
        allow read: if true;
        allow create, delete: if request.auth != null;
    }

    // Platter menu items - readable by anyone, writable by authenticated users
    match /platterMenuItems/{itemId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Platter pricing config - readable by anyone, writable by authenticated users
    match /platterPricingConfig/{configId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Platter orders - anyone can create (public ordering), authenticated users can read/update
    match /platterOrders/{orderId} {
      allow read: if request.auth != null;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }
  }
}
